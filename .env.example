# Copy to .env and fill in. NEVER commit real values.

# Freshly generated throwaway wallet for testnets only
AGENT_PRIVATE_KEY=0x...

# Public RPCs (defaults below work without signup)
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
CREDITCOIN_TESTNET_RPC_URL=https://rpc.cc3-testnet.creditcoin.network

# Hosted proof-builder service for CC3 Testnet
PROVER_URL=https://prover.cc3-testnet.creditcoin.network

# Optional, disclosed OpenAI-compatible parser and history Q&A. Leave the key
# empty to use the deterministic local engine everywhere.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Native-payment discovery only scans a short incremental window. For a known
# older attested payment, pass --tx 0x... to the agent instead.
NATIVE_SCAN_BLOCKS=32
RECOVERY_BLOCK_WINDOW=20000

# Live-mode targets (agent + e2e:settle:live)
ASC_ADDRESS=
INBOX_ADDRESS=
# LIVE=1
